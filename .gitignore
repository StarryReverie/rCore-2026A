# Rust build products and local editor files.
target/
user/build/
ci-user/
*.swp
*.swo
*~
__pycache__/
*.py[cod]
.idea/

# Distribute course tooling and configuration examples on main.
!/.course-monitor/
!/.course-monitor/**
/.course-monitor/node/
/.course-monitor/**/__pycache__/
/.course-monitor/**/*.py[cod]
!/.devcontainer/
!/.devcontainer/**
!/.agents/
!/.agents/plugins/
!/.agents/plugins/marketplace.json
!/.claude-plugin/
!/.claude-plugin/marketplace.json
!/.ai/
!/.ai/.gitignore
!/.ai/agent-sessions/
!/.ai/agent-sessions/**
!/.ai/events/
!/.ai/events/**
!/.ai/submissions/
!/.ai/submissions/**
/.ai/course-tools/
/.ai/ide/

# Track shared project settings and examples, keep local archive policies private.
!/.codex/
/.codex/*
!/.codex/config.example.toml
!/.codex/session-archive.example.json
!/.claude/
/.claude/*
!/.claude/settings.example.json
!/.claude/session-archive.example.json
!/.cursor/
/.cursor/*
!/.cursor/hooks.example.json
!/.cursor/session-archive.example.json
.vscode/
!/.vscode/
/.vscode/*
!/.vscode/settings.json
!/.vscode/session-archive.example.json
!/.vscode/copilot-hooks.example.json
/.github/hooks/rcore-session-archive.json

# Local recording runtime and client configuration.
/.opencode/session-archive.json
/.opencode/rcore-hooks/
/.opencode/plugins/rcore-session-archive.js
!/.opencode/
/.opencode/*
!/.opencode/session-archive.example.json

# pi course-recording extension; client config stays local.
!/.pi/
/.pi/*
!/.pi/extensions/
!/.pi/extensions/**
!/.pi/session-archive.example.json

# >>> course-tool records
!/.ai/
